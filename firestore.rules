rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Regla para la colección de usuarios
    match /users/{userId} {
      // Permitir lectura si el usuario está autenticado y es el dueño del documento
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Permitir escritura (crear) si el usuario está autenticado y es el dueño del documento
      allow create: if request.auth != null && request.auth.uid == userId;
      
      // Permitir actualización si el usuario está autenticado y es el dueño del documento
      allow update: if request.auth != null && request.auth.uid == userId;
      
      // No permitir eliminación por defecto
      allow delete: if false;
    }
    
    // Denegar acceso a cualquier otra colección por defecto
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
